# Copy to .env and fill in. .env is gitignored: never commit it (the repo is public).
# On the NAS, .env sits next to docker-compose.yml.

COMPOSE_PROJECT_NAME=solar-monitor
TZ=Africa/Johannesburg

# Logger ("dongle") serial = "Device serial number" on the LSW-3 web UI, not the inverter's serial.
# Inverter serial is optional: if set, the poller warns when the inverter reports a different one
# (an IP that now points at another inverter).
# Name is what the UI shows, e.g. "INV 1 · A".

INVERTER_0_NAME=
INVERTER_0_HOST=192.168.x.x
INVERTER_0_DONGLE_SERIAL=
INVERTER_0_INVERTER_SERIAL=

INVERTER_1_NAME=
INVERTER_1_HOST=192.168.x.x
INVERTER_1_DONGLE_SERIAL=
INVERTER_1_INVERTER_SERIAL=

INVERTER_2_NAME=
INVERTER_2_HOST=192.168.x.x
INVERTER_2_DONGLE_SERIAL=
INVERTER_2_INVERTER_SERIAL=

DB_PASSWORD=

# Optional
# POLL_INTERVAL_SECONDS=10
# WEB_PORT=8090
# DB_PORT=5433
# TAG=latest
